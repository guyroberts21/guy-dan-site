# Shared password the two of you type once to access the site.
SITE_PASSWORD=change-me

# Random string used to sign the auth cookie. Use any long random value.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Postgres connection string. When you link Vercel Postgres in the dashboard,
# this gets set automatically. For local dev, use the same URL or any Postgres.
POSTGRES_URL=postgres://user:pass@host:5432/dbname?sslmode=require
